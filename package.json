{
  "name": "nano-bplist-creator",
  "version": "0.1.0",
  "description": "Binary Mac OS X Plist (property list) creator.",
  "keywords": [
    "bplist",
    "creator",
    "plist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plist-js/nano-bplist-creator.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "u": "bun run --sequential format lint build test",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "bun test",
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "nano-stream-buffers": "^0.1.0"
  },
  "devDependencies": {
    "@gameroman/config": "0.2.6",
    "@types/bun": "1.3.14",
    "bplist-parser": "0.3.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
